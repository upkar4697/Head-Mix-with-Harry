                    <i class="fa-solid fa-layer-group text-green-600 dark:text-green-400"></i>
                    <span>All Emails Stream</span>
                </span>
                <button onclick="closeInspector()" class="px-2.5 py-1 text-xs bg-white hover:bg-slate-100 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-300 dark:border-slate-700 rounded flex items-center space-x-1 shadow-xs transition">
                    <i class="fa-solid fa-xmark"></i>
                    <span>Close View</span>
                </button>
            </div>

            <div id="sideEmailGrid" class="flex-1 overflow-y-auto p-3 grid grid-cols-2 gap-2.5 align-content-start bg-slate-50/50 dark:bg-slate-950/50"></div>
        </div>

        <div class="hidden md:flex flex-1 bg-white dark:bg-slate-900 flex-col h-full transition-colors duration-200">
            <div class="px-5 py-3 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between bg-slate-50 dark:bg-slate-950">
                <div class="flex items-center space-x-2 flex-wrap gap-y-2">
                    <div class="flex items-center space-x-1 bg-white dark:bg-slate-800 p-1 rounded-xl border border-slate-200 dark:border-slate-700 text-xs shadow-xs mr-2">
                        <button onclick="navigateMail('prev')" id="prevMailBtn" title="Previous Email (Left Arrow)" class="px-2.5 py-1.5 rounded-lg text-slate-600 dark:text-slate-300 hover:text-green-600 hover:bg-slate-100 dark:hover:bg-slate-700 transition font-bold">
                            <i class="fa-solid fa-chevron-left"></i>
                        </button>
                        <span class="text-slate-300 dark:text-slate-700 font-bold">|</span>
                        <button onclick="navigateMail('next')" id="nextMailBtn" title="Next Email (Right Arrow)" class="px-2.5 py-1.5 rounded-lg text-slate-600 dark:text-slate-300 hover:text-green-600 hover:bg-slate-100 dark:hover:bg-slate-700 transition font-bold">
