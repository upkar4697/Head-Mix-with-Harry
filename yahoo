<body class="bg-slate-100 text-slate-800 dark:bg-slate-950 dark:text-slate-100 min-h-screen font-sans flex flex-col justify-between transition-colors duration-200">

    <div>
        <!-- Top Navigation Bar -->
        <header class="border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 sticky top-0 z-30 px-4 py-3 shadow-sm transition-colors duration-200">
            <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-4">
                <div class="flex items-center space-x-3">
                    <div class="bg-gradient-to-tr from-indigo-600 to-purple-600 text-white p-2.5 rounded-xl shadow-md shadow-indigo-200 dark:shadow-none flex items-center justify-center">
                        <i class="fa-solid fa-envelope-open-text text-lg"></i>
                    </div>
                    <div>
                        <h1 class="font-black text-lg text-slate-900 dark:text-white tracking-tight flex items-center gap-1.5">
                            AllMailSpot <span class="text-[10px] bg-green-50 dark:bg-green-950 text-green-600 dark:text-green-400 border border-green-200 dark:border-green-800 px-1.5 py-0.5 rounded font-bold uppercase">Pro</span>
                        </h1>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Live Multi-ID Streamer &amp; Inspector</p>
                    </div>
                </div>

                <!-- Controls & Search -->
                <div class="flex items-center space-x-3 flex-wrap">
                    <!-- Search Input -->
                    <div class="flex items-center space-x-2 bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-1.5 shadow-sm focus-within:border-green-600">
                        <i class="fa-solid fa-magnifying-glass text-slate-400 text-xs"></i>
                        <input type="text" id="searchInput" oninput="renderFilteredGrids()" placeholder="Search emails..." class="bg-transparent text-xs text-slate-700 dark:text-slate-200 font-medium outline-none w-36 sm:w-48">
                    </div>

                    <!-- DATE RANGE PICKERS -->
                    <div class="flex items-center space-x-1.5 bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg px-2.5 py-1.5 shadow-sm text-xs">
                        <i class="fa-regular fa-calendar text-slate-500 dark:text-slate-400"></i>
                        <input type="date" id="dateFrom" onchange="startFreshSync()" title="From Date" class="bg-transparent text-slate-700 dark:text-slate-200 font-medium outline-none cursor-pointer">
                        <span class="text-slate-400 font-bold">-</span>
                        <input type="date" id="dateTo" onchange="startFreshSync()" title="To Date" class="bg-transparent text-slate-700 dark:text-slate-200 font-medium outline-none cursor-pointer">
                    </div>

                    <!-- THEME TOGGLE BUTTON -->
                    <button onclick="toggleTheme()" title="Toggle Theme" class="p-2 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-300 dark:border-slate-700 rounded-lg text-xs transition shadow-sm">
                        <i id="themeIcon" class="fa-solid fa-moon"></i>
                    </button>

                    <button onclick="toggleConfigModal()" class="px-3 py-1.5 bg-white hover:bg-slate-50 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-300 dark:border-slate-700 text-xs font-semibold rounded-lg flex items-center space-x-1.5 shadow-sm transition">
                        <i class="fa-solid fa-key text-green-600 dark:text-green-400"></i>
                        <span>Accounts (<span id="accountCountBadge">2</span>)</span>
                    </button>

                    <button onclick="startFreshSync()" id="fetchBtn" class="px-4 py-1.5 bg-green-600 hover:bg-green-700 text-white text-xs font-semibold rounded-lg flex items-center space-x-2 transition shadow-md shadow-green-200 dark:shadow-none">
                        <i class="fa-solid fa-rotate-right fa-spin" id="refreshSpinner"></i>
                        <span>Sync Live</span>
                    </button>
                </div>
            </div>
        </header>

        <!-- Main Container -->
        <main class="max-w-7xl mx-auto p-4 md:p-6">
            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-3.5 rounded-xl shadow-xs mb-5 flex flex-col md:flex-row md:items-center justify-between gap-3 transition-colors duration-200">
                <div class="flex items-center space-x-3">
                    <div class="text-xs text-slate-600 dark:text-slate-300 font-medium flex items-center space-x-2">
                        <span>Displaying <span id="mailCount" class="font-bold text-slate-900 dark:text-white">0</span> emails</span>
                        <span id="syncStatusBadge" class="text-[10px] bg-green-50 dark:bg-green-950 text-green-700 dark:text-green-300 px-2 py-0.5 rounded-full font-semibold animate-pulse border border-green-200 dark:border-green-800">Fetching chunk (7)...</span>
                    </div>
                </div>

                <div class="flex items-center space-x-2 overflow-x-auto pb-1 md:pb-0" id="sourceFiltersContainer">
                    <span class="text-xs font-bold text-slate-500 dark:text-slate-400 mr-1"><i class="fa-solid fa-filter mr-1 text-green-600"></i>Sources:</span>
                </div>

                <div class="text-xs text-slate-500 dark:text-slate-400 flex items-center space-x-2 shrink-0">
                    <span id="timerCountdown" class="bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 px-2.5 py-1 rounded-md font-mono text-[11px] border border-slate-200 dark:border-slate-700">Auto-syncing in 4:54</span>
                    <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                </div>
            </div>

            <!-- DEFAULT FULL-WIDTH GRID (5 Columns Desktop / 2 Mobile) -->
            <div id="emailGrid" class="grid grid-cols-2 lg:grid-cols-5 gap-4"></div>

            <div id="emptyState" class="text-center py-24 border border-dashed border-slate-300 dark:border-slate-800 rounded-2xl bg-white dark:bg-slate-900 shadow-sm">
                <i class="fa-solid fa-inbox text-4xl text-slate-300 dark:text-slate-700 mb-3"></i>
                <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-300">No Emails Found</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 max-w-sm mx-auto mt-1">Make sure your Yahoo App Passwords and Spot IDs are correctly configured and match the target date range.</p>
            </div>
        </main>
    </div>

    <!-- FOOTER -->
    <footer class="border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 py-4 px-6 text-center text-xs text-slate-500 dark:text-slate-400 mt-10 transition-colors duration-200">
        <p>© 2026 AllMailSpot. All rights reserved. • Designed By <strong class="text-green-600 dark:text-green-400 font-bold">"Adimon"</strong></p>
    </footer>

    <!-- FULLSCREEN SPLIT INSPECTOR OVERLAY -->
