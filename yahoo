                        </div>
                    </div>
                    <div id="codeMirrorContainer" class="flex-1 relative overflow-hidden bg-slate-50 dark:bg-slate-950"><div class="CodeMirror cm-s-default CodeMirror-wrap" translate="no" style="clip-path: inset(0px);"><div style="overflow: hidden; position: relative; width: 3px; height: 0px;"><textarea autocorrect="off" autocapitalize="off" spellcheck="false" tabindex="0" style="position: absolute; bottom: -1em; padding: 0px; width: 1000px; height: 1em; min-height: 1em; outline: none;"></textarea></div><div class="CodeMirror-vscrollbar" tabindex="-1" cm-not-content="true"><div style="min-width: 1px;"></div></div><div class="CodeMirror-hscrollbar" tabindex="-1" cm-not-content="true"><div style="height: 100%; min-height: 1px;"></div></div><div class="CodeMirror-scrollbar-filler" cm-not-content="true"></div><div class="CodeMirror-gutter-filler" cm-not-content="true"></div><div class="CodeMirror-scroll" tabindex="-1"><div class="CodeMirror-sizer" style="margin-left: 0px;"><div style="position: relative;"><div class="CodeMirror-lines" role="presentation"><div role="presentation" style="position: relative; outline: none;"><div class="CodeMirror-measure"><pre class="CodeMirror-line-like"><span>xxxxxxxxxx</span></pre><div class="CodeMirror-linenumber CodeMirror-gutter-elt"><div>1</div></div></div><div class="CodeMirror-measure"></div><div style="position: relative; z-index: 1;"></div><div class="CodeMirror-cursors"></div><div class="CodeMirror-code" role="presentation"></div></div></div></div></div><div style="position: absolute; height: 50px; width: 1px;"></div><div class="CodeMirror-gutters"><div class="CodeMirror-gutter CodeMirror-linenumbers" style="width: 1px;"></div></div></div></div></div>
                </div>
            </div>
        </div>
    </div>

    <!-- NOTIFICATION TOAST -->
    <div id="toast" class="fixed bottom-4 right-4 bg-slate-900 dark:bg-slate-800 text-white px-4 py-2.5 rounded-lg shadow-2xl transition transform translate-y-20 opacity-0 flex items-center space-x-2 z-50 text-xs font-medium border border-slate-700">
        <i class="fa-solid fa-circle-check text-emerald-400"></i>
        <span id="toastMessage">Notification</span>
    </div>

    <!-- ACCOUNTS CONFIG MODAL -->
    <div id="configModal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl max-w-lg w-full p-5 space-y-4 shadow-2xl">
            <div class="flex justify-between items-center border-b border-slate-200 dark:border-slate-800 pb-3">
                <h3 class="font-bold text-slate-900 dark:text-white text-sm flex items-center space-x-2">
                    <i class="fa-solid fa-sliders text-green-600 dark:text-green-400"></i>
                    <span>Configure Yahoo Credentials</span>
                </h3>
                <button onclick="toggleConfigModal()" class="text-slate-400 hover:text-slate-700 dark:hover:text-white text-sm"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400">Enter your credentials in format: <code class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded text-green-600 dark:text-green-400 font-mono">imappassword, allMailSpotid</code> (One per line).</p>
            
            <textarea id="credentialsInput" rows="6" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl p-3 text-xs font-mono text-slate-800 dark:text-slate-200 outline-none focus:border-green-600 dark:focus:border-green-500 focus:bg-white dark:focus:bg-slate-900 transition" placeholder="imappassword1, spotid1@yahoo.com
imappassword2, spotid2@yahoo.com
imappassword3, spotid3@yahoo.com"></textarea>

            <div class="flex justify-end space-x-2 pt-2">
                <button onclick="toggleConfigModal()" class="px-4 py-1.5 text-xs bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 rounded-lg text-slate-700 dark:text-slate-300 font-medium">Cancel</button>
                <button onclick="saveCredentials()" class="px-4 py-1.5 text-xs bg-green-600 hover:bg-green-700 text-white rounded-lg font-semibold shadow-xs">Save Credentials</button>
            </div>
        </div>
    </div>

    <script>
        let fetchedEmails = [];
        let displayedFilteredEmails = [];
        let activeIndex = null;
        let cmEditor = null;
        let activeSearchHighlightMark = null;

        let isSyncRunning = false;
        let countdownSeconds = 300;
        let activeSourceFilters = new Set();
        const CHUNK_SIZE = 7;
        const defaultCreds = "imappassword1, allMailSpotid1@yahoo.com\nimappassword2, allMailSpotid2@yahoo.com\nimappassword3, allMailSpotid3@yahoo.com";

        window.addEventListener('DOMContentLoaded', () => {
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('dateFrom').value = today;
            document.getElementById('dateTo').value = today;

            if (!localStorage.getItem('yahoo_creds')) {
                localStorage.setItem('yahoo_creds', defaultCreds);
            }
            document.getElementById('credentialsInput').value = localStorage.getItem('yahoo_creds');

            // Load saved source filters from localStorage if available
            loadSavedFilters();
            
            initTheme();
            updateAccountBadge();
            initCodeMirror();

            startFreshSync();
            initTenMinuteScheduler();
            initKeyboardNavigation();
        });

        function initTheme() {
            const savedTheme = localStorage.getItem('allmailspot_theme') || 'light';
            if (savedTheme === 'dark') {
                document.documentElement.classList.add('dark');
                document.getElementById('themeIcon').className = "fa-solid fa-sun";
            } else {
                document.documentElement.classList.remove('dark');
                document.getElementById('themeIcon').className = "fa-solid fa-moon";
            }
        }

        function toggleTheme() {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('allmailspot_theme', isDark ? 'dark' : 'light');
            document.getElementById('themeIcon').className = isDark ? "fa-solid fa-sun" : "fa-solid fa-moon";
            
            if (cmEditor) {
                cmEditor.setOption("theme", isDark ? "dracula" : "default");
            }
        }

        function initKeyboardNavigation() {
            window.addEventListener('keydown', (e) => {
                const overlay = document.getElementById('inspectorOverlay');
                if (overlay.classList.contains('hidden')) return;
                const activeTag = document.activeElement ? document.activeElement.tagName.toLowerCase() : '';
                if (activeTag === 'input' || activeTag === 'textarea' || activeTag === 'select') return;

                if (e.key === 'ArrowLeft') {
                    e.preventDefault();
                    navigateMail('prev');
                } else if (e.key === 'ArrowRight') {
                    e.preventDefault();
                    navigateMail('next');
                } else if (e.key === 'Escape') {
                    closeInspector();
                }
            });
        }

        function initTenMinuteScheduler() {
            setInterval(() => {
                countdownSeconds--;
                if (countdownSeconds <= 0) {
                    countdownSeconds = 300;
                    startContinuousSync();
                }
                updateCountdownDisplay();
            }, 1000);
        }

        function updateCountdownDisplay() {
            const mins = Math.floor(countdownSeconds / 60);
            const secs = countdownSeconds % 60;
            const formatted = `${mins}:${secs < 5 ? '0' : ''}${secs}`;
            document.getElementById('timerCountdown').textContent = `Auto-syncing in ${formatted}`;
        }

        function startFreshSync() {
            fetchedEmails = [];
            renderFilteredGrids();
            startContinuousSync();
        }

        async function startContinuousSync() {
            if (isSyncRunning) return;
            const accounts = parseStoredCredentials();
            if (accounts.length === 0) return;

            isSyncRunning = true;
            const dateFromVal = document.getElementById('dateFrom').value;
            const dateToVal = document.getElementById('dateTo').value;
            const spinner = document.getElementById('refreshSpinner');
            const syncBadge = document.getElementById('syncStatusBadge');

            spinner.classList.add('fa-spin');
            syncBadge.classList.remove('hidden');

            let offset = 0;
            let hasMore = true;

            try {
                while (hasMore) {
                    const res = await fetch('/api/fetch-chunk', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ 
                            accounts, 
                            date: dateFromVal, 
                            date_to: dateToVal,
                            offset: offset, 
                            limit: CHUNK_SIZE 
                        })
                    });

                    const data = await res.json();
                    if (data.status === 'success' && data.emails.length > 0) {
                        data.emails.forEach(newEmail => {
                            if (!fetchedEmails.some(e => e.id === newEmail.id)) {
                                fetchedEmails.push(newEmail);
                                // If no explicit user saved preference exists yet, default newly discovered sources to selected
                                if (!localStorage.getItem('allmailspot_saved_filters')) {
                                    activeSourceFilters.add(newEmail.source);
                                }
                            }
                        });

                        updateSourceFilterUI();
                        renderFilteredGrids();

                        offset += CHUNK_SIZE;
                        if (data.emails.length < CHUNK_SIZE) {
                            hasMore = false;
                        }
                        await new Promise(r => setTimeout(r, 300));
                    } else {
                        hasMore = false;
                    }
                }
            } catch (err) {
                console.error("Continuous Sync Engine Error:", err);
            } finally {
                isSyncRunning = false;
                countdownSeconds = 300;
                spinner.classList.remove('fa-spin');
                syncBadge.classList.add('hidden');
            }
        }

        function loadSavedFilters() {
            const saved = localStorage.getItem('allmailspot_saved_filters');
            if (saved) {
                try {
                    activeSourceFilters = new Set(JSON.parse(saved));
                } catch(e) {
                    activeSourceFilters = new Set();
                }
            }
        }

        function saveFiltersToStorage() {
            localStorage.setItem('allmailspot_saved_filters', JSON.stringify([...activeSourceFilters]));
        }

        function updateSourceFilterUI() {
            const container = document.getElementById('sourceFiltersContainer');
            const labelHtml = '<span class="text-xs font-bold text-slate-500 dark:text-slate-400 mr-1"><i class="fa-solid fa-filter mr-1 text-green-600"></i>Sources:</span>';
            const allSources = [...new Set(fetchedEmails.map(e => e.source))].sort();
            
            // If filters were never touched, default all discovered sources to active
            if (!localStorage.getItem('allmailspot_saved_filters') && activeSourceFilters.size === 0 && allSources.length > 0) {
                allSources.forEach(s => activeSourceFilters.add(s));
                saveFiltersToStorage();
            }

            let checkboxesHtml = labelHtml;
            allSources.forEach(source => {
                const isChecked = activeSourceFilters.has(source) ? 'checked' : '';
                checkboxesHtml += `
                    <label class="inline-flex items-center space-x-1.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 px-2.5 py-1 rounded-md text-xs cursor-pointer hover:bg-slate-100 dark:hover:bg-slate-700">
                        <input type="checkbox" value="${source}" ${isChecked} onchange="toggleSourceFilter('${source}', this.checked)" class="rounded text-green-600 focus:ring-green-500 h-3.5 w-3.5">
                        <span class="text-slate-700 dark:text-slate-200 font-medium">${source}</span>
                    </label>
                `;
            });

            container.innerHTML = checkboxesHtml;
        }

        function toggleSourceFilter(source, isChecked) {
            if (isChecked) {
                activeSourceFilters.add(source);
            } else {
                activeSourceFilters.delete(source);
            }
            saveFiltersToStorage();
            renderFilteredGrids();
        }

        function renderFilteredGrids() {
            const searchQuery = document.getElementById('searchInput').value.toLowerCase().trim();
            
            displayedFilteredEmails = fetchedEmails.filter(mail => {
                if (!activeSourceFilters.has(mail.source)) return false;

                if (searchQuery) {
                    const matchSubject = mail.subject.toLowerCase().includes(searchQuery);
                    const matchFromName = mail.from_name.toLowerCase().includes(searchQuery);
                    const matchFromEmail = mail.from_email.toLowerCase().includes(searchQuery);
                    const matchAccount = mail.account.toLowerCase().includes(searchQuery);
                    return matchSubject || matchFromName || matchFromEmail || matchAccount;
                }
                return true;
            });

            renderGrids(displayedFilteredEmails);
        }

        function renderGrids(emails) {
            const mainGrid = document.getElementById('emailGrid');
            const sideGrid = document.getElementById('sideEmailGrid');
            const emptyState = document.getElementById('emptyState');
            document.getElementById('mailCount').textContent = emails.length;

            mainGrid.innerHTML = '';
            sideGrid.innerHTML = '';

            if (emails.length === 0 && !isSyncRunning) {
                emptyState.classList.remove('hidden');
                return;
            }

            emptyState.classList.add('hidden');

            emails.forEach((mail, idx) => {
                const mainCard = createCardElement(mail, idx);
                mainGrid.appendChild(mainCard);

                const sideCard = createCardElement(mail, idx, true);
                sideGrid.appendChild(sideCard);
            });
        }

        function createCardElement(mail, idx, isSide = false) {
            const card = document.createElement('div');
            const isActive = isSide && activeIndex === idx;

            card.className = `bg-white dark:bg-slate-900 border ${isActive ? 'border-green-600 ring-2 ring-green-600/20 shadow-md' : 'border-slate-200 dark:border-slate-800 hover:border-green-400 dark:hover:border-green-500'} rounded-xl p-3 cursor-pointer transition flex flex-col justify-between shadow-xs hover:shadow-md group`;
            card.onclick = () => selectCardById(mail.id);

            card.innerHTML = `
                <div class="space-y-1.5">
                    <div class="flex items-center justify-between">
                        <span class="font-bold text-slate-900 dark:text-white text-xs truncate max-w-[130px]" title="${escapeHTML(mail.from_name)}">${escapeHTML(mail.from_name)}</span>
                        <span class="text-[9px] uppercase font-bold text-green-600 dark:text-green-400 bg-green-50 dark:bg-green-950 px-1.5 py-0.5 rounded border border-green-100 dark:border-green-900">${escapeHTML(mail.source)}</span>
                    </div>
                    <div class="text-[11px] text-slate-400 dark:text-slate-500 truncate" title="${escapeHTML(mail.from_email)}">${escapeHTML(mail.from_email)}</div>
                    <h4 class="font-semibold text-slate-700 dark:text-slate-200 text-xs line-clamp-2 group-hover:text-green-600 dark:group-hover:text-green-400 transition mt-1" title="${escapeHTML(mail.subject)}">${escapeHTML(mail.subject)}</h4>
                </div>

                <div class="mt-2.5 pt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-[10px] text-slate-400 dark:text-slate-500">
                    <span class="truncate max-w-[100px]">${escapeHTML(mail.account.split('@')[0])}</span>
                    <i class="fa-solid fa-chevron-right text-slate-300 dark:text-slate-700 group-hover:text-green-600 dark:group-hover:text-green-400 transition"></i>
                </div>
            `;

            return card;
        }

        function selectCardById(mailId) {
            const index = displayedFilteredEmails.findIndex(e => e.id === mailId);
            if (index === -1) return;
            activeIndex = index;
            const email = displayedFilteredEmails[index];

            document.getElementById('modalSubject').textContent = email.subject;
            document.getElementById('modalFromName').textContent = email.from_name;
            document.getElementById('modalFromEmail').textContent = email.from_email;
            document.getElementById('modalAccount').textContent = email.account;
            document.getElementById('modalDate').textContent = email.date;
            document.getElementById('modalSource').textContent = email.source;

            cmEditor.setValue(email.content);
            updateIframe(email.content);

            renderFilteredGrids();

            document.getElementById('inspectorOverlay').classList.remove('hidden');
            setTimeout(() => cmEditor.refresh(), 50);
        }

        function navigateMail(direction) {
            if (displayedFilteredEmails.length === 0 || activeIndex === null) return;

            if (direction === 'prev') {
                if (activeIndex > 0) {
                    activeIndex--;
                } else {
                    activeIndex = displayedFilteredEmails.length - 1;
                }
            } else if (direction === 'next') {
                if (activeIndex < displayedFilteredEmails.length - 1) {
                    activeIndex++;
                } else {
                    activeIndex = 0;
                }
            }

            const targetMail = displayedFilteredEmails[activeIndex];
            selectCardById(targetMail.id);
        }

        function copyStringToClipboard(text, successMessage) {
            if (!text) return;
            
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(text).then(() => {
                    showToast(successMessage);
                }).catch(() => {
                    fallbackCopy(text, successMessage);
                });
            } else {
                fallbackCopy(text, successMessage);
            }
        }

        function fallbackCopy(text, successMessage) {
            const textarea = document.createElement("textarea");
            textarea.value = text;
            textarea.style.position = "fixed";
            textarea.style.left = "-9999px";
            textarea.style.top = "-9999px";
            document.body.appendChild(textarea);
            textarea.focus();
            textarea.select();
            try {
                const successful = document.execCommand('copy');
                if (successful) showToast(successMessage);
                else showToast('Unable to copy text.');
            } catch (err) {
                showToast('Failed to copy text.');
            }
            document.body.removeChild(textarea);
        }

        function copyHeadContent() {
            const code = cmEditor.getValue();
            const lowerCode = code.toLowerCase();
            const headEndIndex = lowerCode.indexOf('</head>');

            let headText = "";
            if (headEndIndex !== -1) {
                headText = code.substring(0, headEndIndex + 7);
            } else {
                const match = code.match(/[\s\S]*?<\/head>/i);
                headText = match ? match[0] : code.substring(0, 2500);
            }

            copyStringToClipboard(headText, 'Copied content up to </head> tag!');
        }

        function copyDirectText(elementId, label) {
            const text = document.getElementById(elementId).textContent;
            copyStringToClipboard(text, `Copied ${label}!`);
        }

        function disableEmailLinks() {
            let code = cmEditor.getValue();
            const tldRegex = /\.(com|net|co|ai|io|app|shop|store|org|me|design|blog|info|in|biz|us|uk|xyz|dev|site|tech|edu|gov|png|jpg|jpeg|gif|svg|css|js)\b/gi;
            code = code.replace(tldRegex, '$1');

            cmEditor.setValue(code);
            updateIframe(code);
            showToast('Removed all dots (.) from links and extensions!');
        }

        function showToast(message) {
            const toast = document.getElementById('toast');
            document.getElementById('toastMessage').textContent = message;
            toast.classList.remove('translate-y-20', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');
            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 2000);
        }

        function initCodeMirror() {
            const isDark = document.documentElement.classList.contains('dark');
            cmEditor = CodeMirror(document.getElementById('codeMirrorContainer'), {
                mode: 'htmlmixed',
                lineNumbers: true,
                styleActiveLine: true,
                autoCloseTags: true,
                autoCloseBrackets: true,
                tabSize: 2,
                indentUnit: 2,
                lineWrapping: true,
                theme: isDark ? 'dracula' : 'default'
            });
        }

        function toggleConfigModal() {
            document.getElementById('configModal').classList.toggle('hidden');
        }

        function updateAccountBadge() {
            const raw = localStorage.getItem('yahoo_creds') || '';
            const count = raw.split('\n').filter(line => line.trim() !== '').length;
            document.getElementById('accountCountBadge').textContent = count;
        }

        function saveCredentials() {
            const val = document.getElementById('credentialsInput').value;
            localStorage.setItem('yahoo_creds', val);
            updateAccountBadge();
            toggleConfigModal();
            startFreshSync();
        }

        function parseStoredCredentials() {
            const raw = localStorage.getItem('yahoo_creds') || '';
            const lines = raw.split('\n');
            const parsed = [];
            for (let line of lines) {
                const parts = line.split(',');
                if (parts.length >= 2) {
                    parsed.push({
                        app_password: parts[0].trim(),
                        spot_id: parts[1].trim()
                    });
                }
            }
            return parsed;
        }

        function closeInspector() {
            document.getElementById('inspectorOverlay').classList.add('hidden');
            activeIndex = null;
        }

        function switchTab(tab) {
            const previewView = document.getElementById('view-preview');
            const editorView = document.getElementById('view-editor');
            const tabPreviewBtn = document.getElementById('tab-preview');
            const tabEditorBtn = document.getElementById('tab-editor');

            if (tab === 'preview') {
                previewView.classList.remove('hidden');
                editorView.classList.add('hidden');
                tabPreviewBtn.className = "px-3.5 py-1.5 rounded-lg bg-green-600 text-white font-semibold transition";
                tabEditorBtn.className = "px-3.5 py-1.5 rounded-lg text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white font-semibold transition";
            } else {
                previewView.classList.add('hidden');
                editorView.classList.remove('hidden');
                tabEditorBtn.className = "px-3.5 py-1.5 rounded-lg bg-green-600 text-white font-semibold transition";
                tabPreviewBtn.className = "px-3.5 py-1.5 rounded-lg text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white font-semibold transition";
                cmEditor.refresh();
            }
        }

        function findHeadTag() {
            switchTab('editor');

            if (activeSearchHighlightMark) {
                activeSearchHighlightMark.clear();
                activeSearchHighlightMark = null;
            }

            const cursor = cmEditor.getSearchCursor('</head>', { line: 0, ch: 0 }, { caseFold: true });
            const statusEl = document.getElementById('headSearchStatus');

            if (cursor.findNext()) {
                cmEditor.setSelection(cursor.from(), cursor.to());
                cmEditor.scrollIntoView({ from: cursor.from(), to: cursor.to() }, 100);
                activeSearchHighlightMark = cmEditor.markText(cursor.from(), cursor.to(), { className: 'cm-search-highlight' });
                
                statusEl.textContent = 'Found </head> tag!';
                statusEl.classList.remove('hidden');
            } else {
                statusEl.textContent = 'No </head> tag found';
                statusEl.classList.remove('hidden');
            }

            setTimeout(() => statusEl.classList.add('hidden'), 3000);
        }

        function updateIframe(htmlContent) {
            const iframe = document.getElementById('previewIframe');
            iframe.srcdoc = htmlContent;
        }

        function applyEditorChanges() {
            const newContent = cmEditor.getValue();
            updateIframe(newContent);
            switchTab('preview');
        }

        function escapeHTML(str) {
            if (!str) return '';
            return str.replace(/[&<>'"]/g, tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag));
        }
    </script>

</body></html>
